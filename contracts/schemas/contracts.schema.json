{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localai:contracts:v1",
  "title": "Local AI Developer Agent – Verträge",
  "description": "Einzige Quelle für C#-Records und Pydantic-Modelle. Regeln: nur Ganzzahlen (keine Gleitkommazahlen), Zeitstempel als UTC-String im Format yyyy-MM-ddTHH:mm:ss.fffZ, optionale Felder werden bei null weggelassen.",
  "x-schemaVersion": 1,
  "$defs": {
    "AgentRole": {
      "type": "string",
      "enum": [
        "Planner",
        "Coder",
        "Tester",
        "Debugger",
        "Reviewer"
      ]
    },
    "ProposalState": {
      "type": "string",
      "enum": [
        "AwaitingApproval",
        "Approved",
        "Running",
        "Succeeded",
        "Failed",
        "Cancelled",
        "OutcomeUnknown",
        "Denied",
        "Expired",
        "Invalidated",
        "Superseded",
        "Rejected"
      ]
    },
    "DecisionKind": {
      "type": "string",
      "enum": [
        "Approve",
        "Deny"
      ]
    },
    "ResultStatus": {
      "type": "string",
      "enum": [
        "Succeeded",
        "Failed",
        "Cancelled",
        "OutcomeUnknown",
        "SkippedByUser"
      ]
    },
    "ToolTarget": {
      "type": "object",
      "description": "Ein einzeln abwählbares Ziel eines Tool-Aufrufs (Datei, Dateibereich, Patch-Datei).",
      "properties": {
        "targetId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "expectedSha256": {
          "type": "string"
        },
        "lineStart": {
          "type": "integer"
        },
        "lineEnd": {
          "type": "integer"
        }
      },
      "required": [
        "targetId",
        "path"
      ]
    },
    "ProposalRequest": {
      "type": "object",
      "description": "Vom Orchestrator eingereichter Vorschlag. Serverfelder (ID, Zeiten, Policyrevision) setzt ausschließlich der Broker.",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentRole"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolTarget"
          }
        },
        "snapshotId": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "taskId",
        "agent",
        "tool",
        "toolVersion",
        "purpose",
        "arguments",
        "targets",
        "snapshotId",
        "idempotencyKey"
      ]
    },
    "ToolProposal": {
      "type": "object",
      "description": "Unveränderlicher Vorschlag. Sein SHA-256 über das kanonische JSON ist die Grundlage jeder Entscheidung.",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "proposalId": {
          "type": "string"
        },
        "parentProposalId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentRole"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolTarget"
          }
        },
        "snapshotId": {
          "type": "string"
        },
        "policyRevision": {
          "type": "integer"
        },
        "sandboxId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "proposalId",
        "runId",
        "taskId",
        "agent",
        "tool",
        "toolVersion",
        "purpose",
        "arguments",
        "targets",
        "snapshotId",
        "policyRevision",
        "sandboxId",
        "createdAt",
        "expiresAt"
      ]
    },
    "ProposalView": {
      "type": "object",
      "properties": {
        "proposal": {
          "$ref": "#/$defs/ToolProposal"
        },
        "proposalSha256": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProposalState"
        }
      },
      "required": [
        "proposal",
        "proposalSha256",
        "state"
      ]
    },
    "UserDecision": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "proposalSha256": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/DecisionKind"
        }
      },
      "required": [
        "proposalId",
        "proposalSha256",
        "decision"
      ]
    },
    "NarrowRequest": {
      "type": "object",
      "description": "Sammelfreigabe: behält nur die genannten Ziele. Erzeugt einen neuen Vorschlag mit neuem Hash.",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "proposalSha256": {
          "type": "string"
        },
        "keepTargetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "proposalId",
        "proposalSha256",
        "keepTargetIds"
      ]
    },
    "TargetResult": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "contentSha256": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "targetId",
        "status"
      ]
    },
    "ToolResult": {
      "type": "object",
      "description": "Ergebnis einer Ausführung. Inhalte sind immer untrusted.",
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "exitCode": {
          "type": "integer"
        },
        "snapshotId": {
          "type": "string"
        },
        "targetResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetResult"
          }
        },
        "skippedTargetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputSha256": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "untrusted": {
          "type": "boolean"
        }
      },
      "required": [
        "invocationId",
        "proposalId",
        "status",
        "snapshotId",
        "targetResults",
        "outputSha256",
        "truncated",
        "untrusted"
      ]
    },
    "ProposalOutcome": {
      "type": "object",
      "description": "Endstand eines Vorschlags; folgt der Kette, falls der Nutzer per Abwahl einen neuen Vorschlag erzeugt hat.",
      "properties": {
        "requestedProposalId": {
          "type": "string"
        },
        "finalProposalId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProposalState"
        },
        "isFinal": {
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/ToolResult"
        }
      },
      "required": [
        "requestedProposalId",
        "finalProposalId",
        "state",
        "isFinal"
      ]
    },
    "FolderRight": {
      "type": "string",
      "enum": [
        "List",
        "Read",
        "Create",
        "Modify",
        "Delete",
        "Execute"
      ]
    },
    "FolderGrant": {
      "type": "object",
      "description": "Ausdrücklich freigegebener Hostordner mit konkreten Rechten. Keine Vererbung auf andere Ordner.",
      "properties": {
        "grantId": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "rights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderRight"
          }
        },
        "recursive": {
          "type": "boolean"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "grantId",
        "root",
        "rights",
        "recursive"
      ]
    },
    "ProjectConfig": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderGrant"
          }
        },
        "toolchains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "name",
        "grants"
      ]
    },
    "SnapshotFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ]
    },
    "SnapshotManifest": {
      "type": "object",
      "description": "Unveränderlicher Stand eines Ordners. snapshotId = SHA-256 über das kanonische JSON von {grantId, files}.",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "snapshotId": {
          "type": "string"
        },
        "grantId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapshotFile"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "snapshotId",
        "grantId",
        "createdAt",
        "files"
      ]
    },
    "SandboxJob": {
      "type": "object",
      "description": "Signierter Auftrag an den Worker in der Sandbox.",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "jobId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "sessionId": {
          "type": "string"
        },
        "invocationId": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/ToolProposal"
        },
        "proposalSha256": {
          "type": "string"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "payloadSha256": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotManifest"
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "sequence",
        "sessionId",
        "invocationId",
        "proposal",
        "proposalSha256",
        "issuedAt",
        "expiresAt"
      ]
    },
    "JobEnvelope": {
      "type": "object",
      "properties": {
        "job": {
          "$ref": "#/$defs/SandboxJob"
        },
        "mac": {
          "type": "string"
        }
      },
      "required": [
        "job",
        "mac"
      ]
    },
    "ResultEnvelope": {
      "type": "object",
      "description": "Antwort des Workers. Immer untrusted; der Host prüft Größe, Zuordnung und Ziele.",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "result": {
          "$ref": "#/$defs/ToolResult"
        }
      },
      "required": [
        "jobId",
        "sequence",
        "result"
      ]
    },
    "BrokerEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProposalState"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "type"
      ]
    },
    "ToolchainInstallKind": {
      "type": "string",
      "enum": [
        "Archive",
        "Installer",
        "None"
      ]
    },
    "ToolchainParameterType": {
      "type": "string",
      "enum": [
        "Path",
        "Choice",
        "Text",
        "Integer"
      ]
    },
    "TestResultFormat": {
      "type": "string",
      "enum": [
        "Trx",
        "JUnit",
        "NUnit",
        "ExitCode"
      ]
    },
    "PackageSourceKind": {
      "type": "string",
      "enum": [
        "NuGet",
        "Pip",
        "Vcpkg",
        "PSModules",
        "None"
      ]
    },
    "ToolchainCommand": {
      "type": "object",
      "description": "Fester Programmaufruf: deklariertes Binary plus Argumentliste, kein Shellstring.",
      "properties": {
        "binary": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "binary",
        "arguments"
      ]
    },
    "ToolchainCheck": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectOutput": {
          "type": "string"
        }
      },
      "required": [
        "binary",
        "arguments"
      ]
    },
    "ToolchainBinary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ]
    },
    "ToolchainInstall": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolchainInstallKind"
        },
        "file": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedMinutes": {
          "type": "integer"
        },
        "check": {
          "$ref": "#/$defs/ToolchainCheck"
        }
      },
      "required": [
        "kind",
        "expectedMinutes",
        "check"
      ]
    },
    "ToolchainSelfTest": {
      "type": "object",
      "description": "Kleines Beispiel, das beim VM-Aufbau gebaut und ausgeführt wird.",
      "properties": {
        "directory": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolchainCommand"
          }
        },
        "expectOutput": {
          "type": "string"
        }
      },
      "required": [
        "directory",
        "steps",
        "expectOutput"
      ]
    },
    "ToolchainParameter": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ToolchainParameterType"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    "ToolchainAction": {
      "type": "object",
      "description": "Aktionsvorlage; Argumente sind Literale oder genau ein {parameter}.",
      "properties": {
        "binary": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolchainParameter"
          }
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "then": {
          "type": "array",
          "description": "Weitere Schritte nach dem ersten (z. B. CMake: konfigurieren → bauen → testen); jeder nur, wenn der vorige mit Exitcode 0 endet.",
          "items": {
            "$ref": "#/$defs/ToolchainCommand"
          }
        }
      },
      "required": [
        "binary",
        "arguments"
      ]
    },
    "ToolchainLicense": {
      "type": "object",
      "properties": {
        "proprietary": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "proprietary"
      ]
    },
    "ToolchainPackageSource": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PackageSourceKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "ToolchainCopy": {
      "type": "object",
      "description": "Datei oder Ordner aus dem Toolchain-Ordner, die beim VM-Aufbau nach guestPath kopiert wird (z. B. Runner-Skripte, Module, Lizenzdatei).",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ]
    },
    "ToolchainManifest": {
      "type": "object",
      "description": "toolchain.json im Toolchain-Ordner (Spezifikation §8 Toolchains).",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "guestPath": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/ToolchainLicense"
        },
        "binaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolchainBinary"
          }
        },
        "install": {
          "$ref": "#/$defs/ToolchainInstall"
        },
        "deploy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolchainCopy"
          }
        },
        "postInstall": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolchainCommand"
          }
        },
        "selfTest": {
          "$ref": "#/$defs/ToolchainSelfTest"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolchainAction"
          }
        },
        "testResultFormat": {
          "$ref": "#/$defs/TestResultFormat"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "packageSource": {
          "$ref": "#/$defs/ToolchainPackageSource"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "version",
        "displayName",
        "guestPath",
        "license",
        "binaries",
        "install",
        "actions",
        "testResultFormat"
      ]
    },
    "ToolchainInfo": {
      "type": "object",
      "description": "Toolchain-Ordner bzw. Registrierung, wie die Oberfläche sie anzeigt.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "fileCount": {
          "type": "integer"
        },
        "totalBytes": {
          "type": "integer"
        },
        "registered": {
          "type": "boolean"
        },
        "registeredDigest": {
          "type": "string"
        },
        "proprietary": {
          "type": "boolean"
        },
        "licenseNote": {
          "type": "string"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usedByProject": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "displayName",
        "directory",
        "digest",
        "fileCount",
        "totalBytes",
        "registered",
        "proprietary",
        "problems",
        "usedByProject"
      ]
    },
    "ToolchainRegistration": {
      "type": "object",
      "description": "Gespeicherte Registrierung mit den bei der Bestätigung festgehaltenen Datei-Hashes.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "version",
        "directory",
        "manifestSha256",
        "digest",
        "files",
        "registeredAt"
      ]
    },
    "AgentState": {
      "type": "string",
      "description": "Zustand eines Agenten in der Live-Ansicht.",
      "enum": [
        "Ready",
        "Queued",
        "Generating",
        "WaitingApproval",
        "WaitingUser",
        "Done",
        "Failed",
        "Cancelled"
      ]
    },
    "ActivityKind": {
      "type": "string",
      "enum": [
        "State",
        "Output",
        "Thinking",
        "Proposal",
        "Task",
        "Chat",
        "Metric",
        "Warning",
        "Error",
        "Heartbeat"
      ]
    },
    "ActivityEvent": {
      "type": "object",
      "description": "Live-Aktivität eines Agenten (reine Anzeige; ändert keine Freigaben). seq vergibt der Broker.",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "description": "Planner, Coder, Tester, Debugger, Reviewer, Orchestrator oder User (nur Broker)"
        },
        "kind": {
          "$ref": "#/$defs/ActivityKind"
        },
        "taskId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "model": {
          "type": "string"
        },
        "tokens": {
          "type": "integer"
        },
        "tokensPerSecond": {
          "type": "number"
        },
        "elapsedMs": {
          "type": "integer"
        },
        "contextTokens": {
          "type": "integer"
        },
        "stalled": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "at",
        "runId",
        "agent",
        "kind"
      ]
    },
    "ActivityReport": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityEvent"
          }
        }
      },
      "required": [
        "runId",
        "events"
      ]
    },
    "OrchestratorCommandKind": {
      "type": "string",
      "enum": [
        "Chat",
        "CancelAgent",
        "CancelRun"
      ]
    },
    "OrchestratorCommand": {
      "type": "object",
      "description": "Auftrag der Oberfläche an den Orchestrator (über den Broker).",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "$ref": "#/$defs/OrchestratorCommandKind"
        },
        "agent": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "kind"
      ]
    },
    "TestCaseFailure": {
      "type": "object",
      "description": "Ein fehlgeschlagener Testfall (aus Trx/JUnit, untrusted).",
      "properties": {
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stackTrace": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "TestReport": {
      "type": "object",
      "description": "Einheitliches Testergebnis eines Toolchain-Laufs (Spezifikation §8, B08). Inhalte untrusted.",
      "properties": {
        "format": {
          "$ref": "#/$defs/TestResultFormat"
        },
        "exitCode": {
          "type": "integer"
        },
        "timedOut": {
          "type": "boolean"
        },
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestCaseFailure"
          }
        },
        "resultFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "exitCode",
        "timedOut",
        "total",
        "passed",
        "failed",
        "skipped",
        "failures"
      ]
    }
  }
}
