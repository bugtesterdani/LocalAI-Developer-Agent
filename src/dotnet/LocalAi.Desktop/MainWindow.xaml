<Window x:Class="LocalAi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LocalAi.Desktop"
        Title="{loc:T AppTitle}"
        Width="1440" Height="860" MinWidth="1000" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F9FAFB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <loc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <loc:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Kopierbare, nicht editierbare Werte; Inhalte werden nie als Markup interpretiert. -->
        <Style x:Key="CopyableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TopButton}"
                            Content="{loc:T StartFakeRun}"
                            Command="{Binding StartFakeRunCommand}" />
                    <Button Style="{StaticResource TopButton}"
                            Content="{loc:T ContinueSandbox}"
                            Command="{Binding ContinueSandboxCommand}"
                            Visibility="{Binding IsSandboxPaused, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource TopButton}"
                            Content="{loc:T RebuildSandbox}"
                            Command="{Binding RebuildSandboxCommand}"
                            Visibility="{Binding IsHyperV, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource TopButton}"
                            Content="{loc:T ReleaseStop}"
                            Command="{Binding ReleaseCommand}" />
                    <Button Content="{loc:T EmergencyStop}"
                            Command="{Binding EmergencyStopCommand}"
                            AutomationProperties.Name="{loc:T EmergencyStop}"
                            Background="#B91C1C" Foreground="White" FontWeight="Bold"
                            Padding="16,4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T AppTitle}" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="  |  " Foreground="#9CA3AF" />
                    <TextBlock Text="{loc:T Project}" Foreground="#D1D5DB" />
                    <TextBlock Text=": " Foreground="#D1D5DB" />
                    <TextBlock Text="{Binding ProjectText}" Foreground="#D1D5DB" />
                    <TextBlock Text="  |  " Foreground="#9CA3AF" />
                    <TextBlock Text="{Binding SandboxText}" ToolTip="{Binding SandboxText}" MaxWidth="560" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FCD34D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnsafeSandbox}" Value="True">
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSandboxProblem}" Value="True">
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="  |  " Foreground="#9CA3AF" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#D1D5DB" />
                    <TextBlock x:Name="StartupStatus" Foreground="#D1D5DB" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Not-Aus-Hinweis: Text, nicht nur Farbe -->
        <Border DockPanel.Dock="Top" Background="#FEE2E2" BorderBrush="#B91C1C" BorderThickness="0,0,0,2" Padding="12,6"
                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:T StoppedBanner}" Foreground="#7F1D1D" FontWeight="Bold" />
        </Border>

        <!-- Meldungen -->
        <StackPanel DockPanel.Dock="Top" Margin="12,4,12,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap"
                       Visibility="{Binding ErrorText, Converter={StaticResource EmptyToCollapsed}}" />
            <TextBlock Text="{Binding InfoText}" Foreground="#065F46" TextWrapping="Wrap"
                       Visibility="{Binding InfoText, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="600" />
            </Grid.ColumnDefinitions>

            <!-- Agenten: Zustand als Text (nicht nur Farbe), Abbruch pro Agent -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T Agents}" Style="{StaticResource SectionHeader}" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding OrchestratorText}" TextWrapping="Wrap" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#374151" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrchestratorProblem}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{loc:T StopOrchestrator}" Command="{Binding StopOrchestratorCommand}" Margin="0,6,0,0" Padding="8,2"
                                Visibility="{Binding IsOrchestratorProblem, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"
                         AutomationProperties.Name="{loc:T Agents}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right" Content="{loc:T CancelAgent}" Command="{Binding CancelCommand}"
                                        Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Name}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#374151" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStalled}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Chat, Live-Aktivität, Ereignisse, Toolchains -->
            <TabControl Grid.Column="1" Margin="0,0,12,0" SelectedIndex="{Binding SelectedTab}">
                <TabItem Header="{loc:T TabChat}">
                    <DockPanel Margin="0,6,0,0">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Content="{loc:T SendChat}" Command="{Binding SendChatCommand}" Padding="14,6" FontWeight="SemiBold" />
                                <Button Content="{loc:T CancelRun}" Command="{Binding CancelRunCommand}" Padding="14,4" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:T ChatHint}" Foreground="#4B5563" FontSize="11" Margin="0,0,0,2" />
                            <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="56" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{loc:T ChatHint}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendChatCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <!-- Schrittlimit erreicht: vollständige Eingabe des nächsten Schritts, bearbeitbar -->
                        <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#B45309" BorderThickness="2" Padding="8" Margin="0,0,0,8"
                                Visibility="{Binding HasLimitQuestion, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding LimitQuestion}">
                                <TextBlock Text="{loc:T LimitTitle}" FontWeight="Bold" Foreground="#78350F" />
                                <TextBlock Text="{Binding HeaderText}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" Foreground="#B91C1C" FontWeight="Bold" Margin="0,0,0,6"
                                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T LimitExtraSteps}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding ExtraStepsText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0"
                                             AutomationProperties.Name="{loc:T LimitExtraSteps}" />
                                    <TextBlock Text="{Binding ExtraStepsError}" Foreground="#B91C1C" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:T LimitTask}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TaskText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                         AutomationProperties.Name="{loc:T LimitTask}" />
                                <Expander Header="{loc:T LimitRest}" Margin="0,6,0,0">
                                    <TextBox Text="{Binding RestText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="300" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                             AutomationProperties.Name="{loc:T LimitRest}" />
                                </Expander>
                                <Expander Header="{loc:T LimitSystem}" Margin="0,4,0,0">
                                    <TextBox Text="{Binding SystemText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="300" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                             AutomationProperties.Name="{loc:T LimitSystem}" />
                                </Expander>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#4B5563">
                                    <Run Text="{Binding ChangeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:T LimitContinue}" Command="{Binding ContinueCommand}" Padding="14,4" FontWeight="SemiBold" />
                                    <Button Content="{loc:T LimitStop}" Command="{Binding StopCommand}" Padding="14,4" Margin="8,0,0,0" />
                                    <Button Content="{loc:T LimitReset}" Command="{Binding ResetCommand}" Padding="10,4" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LimitMoreText}" Foreground="#78350F" Margin="0,0,0,6"
                                   Visibility="{Binding LimitMoreText, Converter={StaticResource EmptyToCollapsed}}" />
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T ChatEmpty}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,8"
                                   Visibility="{Binding HasChat, Converter={StaticResource InverseBoolToVis}}" />
                        <ListBox ItemsSource="{Binding Chat}" loc:AutoScroll.ToEnd="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Sender}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2937" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Time}" Foreground="#6B7280" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBox AutomationProperties.Name="{Binding Text}" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{loc:T TabActivity}">
                    <DockPanel Margin="0,6,0,0" DataContext="{Binding SelectedAgent}">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="{loc:T CancelAgent}" Command="{Binding CancelCommand}" Padding="10,2"
                                    VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding StateText}" Margin="12,3,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{loc:T LabelCurrentTask}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T LabelMetrics}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding MetricText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetailText}" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{loc:T ActivityHint}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{loc:T LabelOutput}" Style="{StaticResource SectionHeader}" />
                            <TextBox Grid.Row="1" Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" loc:AutoScroll.ToEnd="True"
                                     AutomationProperties.Name="{loc:T LabelOutput}" />
                            <Expander Grid.Row="2" Header="{loc:T LabelThinking}" Margin="0,6,0,0"
                                      Visibility="{Binding HasThinking, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding ThinkingText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                         TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" loc:AutoScroll.ToEnd="True"
                                         Foreground="#4B5563" AutomationProperties.Name="{loc:T LabelThinking}" />
                            </Expander>
                            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#E5E7EB" Margin="0,6,0,6" />
                            <TextBlock Grid.Row="4" Text="{loc:T LabelFeed}" Style="{StaticResource SectionHeader}" />
                            <ListView Grid.Row="5" ItemsSource="{Binding Entries}" loc:AutoScroll.ToEnd="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#6B7280" Width="60" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" FontWeight="SemiBold" Width="80" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{loc:T TabEvents}">
                        <ListView ItemsSource="{Binding EventLog}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#6B7280" Width="64" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                </TabItem>

                <TabItem Header="{loc:T TabToolchains}">
                        <!-- Toolchains: Registrierung als sichtbare, bestätigte Aktion -->
                        <DockPanel Margin="0,6,0,0">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="{loc:T ScanToolchains}" Command="{Binding ScanToolchainsCommand}" Padding="8,2" />
                                <TextBlock Text="{loc:T Toolchains}" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:T ToolchainsHint}" TextWrapping="Wrap" Foreground="#4B5563" FontSize="11" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ToolchainsEmptyText}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,4,0,0"
                                       Visibility="{Binding ToolchainsEmptyText, Converter={StaticResource EmptyToCollapsed}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Toolchains}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="6" Margin="0,4,0,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="{loc:T RegisterToolchain}" Command="{Binding RegisterCommand}" Padding="8,2" Margin="4,0,0,0" />
                                                        <Button Content="{loc:T UnregisterToolchain}" Command="{Binding UnregisterCommand}" Padding="8,2" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="#374151" TextWrapping="Wrap" />
                                                        <TextBox AutomationProperties.Name="{Binding TitleText}" Text="{Binding DetailText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontSize="11" />
                                                        <TextBlock Text="{Binding ProblemsText}" Foreground="#B91C1C" TextWrapping="Wrap"
                                                                   Visibility="{Binding ProblemsText, Converter={StaticResource EmptyToCollapsed}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                </TabItem>

                <TabItem Header="{loc:T TabSystem}">
                        <!-- System (M7): Versions-/Offline-Manifest, Audit-Prüfung, Diagnosepaket, Sicherung -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:T SystemRefresh}" Command="{Binding RefreshManifestCommand}" Padding="8,2" />
                                    <TextBlock Text="{loc:T SystemVersions}" Style="{StaticResource SectionHeader}" />
                                </DockPanel>
                                <TextBlock Text="{loc:T SystemMissing}" Style="{StaticResource FieldLabel}" Foreground="DarkRed"
                                           Visibility="{Binding ManifestProblemsText, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBox Text="{Binding ManifestProblemsText, Mode=OneWay}" Style="{StaticResource CopyableValue}" Foreground="#B91C1C"
                                         AutomationProperties.Name="{loc:T SystemMissing}"
                                         Visibility="{Binding ManifestProblemsText, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBox Text="{Binding ManifestText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas" FontSize="12"
                                         AutomationProperties.Name="{loc:T SystemVersions}" Margin="0,4,0,0" />

                                <TextBlock Text="{loc:T SystemActions}" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                                <TextBlock Text="{loc:T SystemHint}" TextWrapping="Wrap" Foreground="#4B5563" FontSize="11" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{loc:T VerifyAudit}" Command="{Binding VerifyAuditCommand}" Padding="8,2" Margin="0,0,6,4" />
                                    <Button Content="{loc:T CreateBackup}" Command="{Binding CreateBackupCommand}" Padding="8,2" Margin="0,0,6,4" />
                                    <Button Content="{loc:T ExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" Padding="8,2" Margin="0,0,6,4" />
                                </WrapPanel>
                                <CheckBox Content="{loc:T IncludeLogs}" IsChecked="{Binding IncludeLogs}" Margin="0,2,0,0" />
                                <TextBox Text="{Binding SystemResultText, Mode=OneWay}" Style="{StaticResource CopyableValue}" Margin="0,8,0,0"
                                         AutomationProperties.Name="{loc:T SystemActions}" />
                            </StackPanel>
                        </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Freigaben -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ApprovalsHeader}" Style="{StaticResource SectionHeader}" />
                <TextBlock DockPanel.Dock="Top" Text="{loc:T NoApprovals}" Foreground="#4B5563"
                           Visibility="{Binding HasApprovals, Converter={StaticResource InverseBoolToVis}}" />
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Approvals}" SelectedItem="{Binding SelectedApproval}"
                         MaxHeight="170" Margin="0,0,0,8"
                         Visibility="{Binding HasApprovals, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Foreground="#4B5563" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Freigabekarte -->
                <ContentControl Content="{Binding SelectedApproval}" Focusable="False"
                                Visibility="{Binding SelectedApproval, Converter={StaticResource EmptyToCollapsed}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="12">
                                <DockPanel FocusManager.FocusedElement="{Binding ElementName=DenyButton}">
                                    <!-- Entscheidungsleiste: Fokus standardmäßig auf Ablehnen, Enter erlaubt nie. -->
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <TextBlock Text="{loc:T SelectionChangedHint}" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Visibility="{Binding SelectionChanged, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="DenyButton" Content="{loc:T Deny}" Command="{Binding DenyCommand}"
                                                    Padding="14,6" Margin="0,0,8,0" IsDefault="False" IsCancel="False" />
                                            <Button Content="{loc:T ApplySelection}" Command="{Binding ApplySelectionCommand}"
                                                    Padding="14,6" Margin="0,0,8,0"
                                                    Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="{Binding ApproveText}" Command="{Binding ApproveCommand}"
                                                    AutomationProperties.Name="{Binding ApproveText}"
                                                    Padding="14,6" IsDefault="False" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />

                                            <TextBlock Text="{loc:T LabelPurpose}" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelPurpose}" Text="{Binding PurposeText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:T LabelRole}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelRole}" Text="{Binding RoleText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                                    <TextBlock Text="{loc:T LabelTool}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelTool}" Text="{Binding ToolText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                                    <TextBlock Text="{loc:T LabelValidUntil}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelValidUntil}" Text="{Binding ValidUntilText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{loc:T LabelSnapshot}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelSnapshot}" Text="{Binding SnapshotText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                                    <TextBlock Text="{loc:T LabelSandbox}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelSandbox}" Text="{Binding SandboxText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />
                                                    <TextBlock Text="{loc:T LabelParent}" Style="{StaticResource FieldLabel}"
                                                               Visibility="{Binding HasParent, Converter={StaticResource BoolToVis}}" />
                                                    <TextBox AutomationProperties.Name="{loc:T LabelParent}" Text="{Binding ParentText, Mode=OneWay}" Style="{StaticResource CopyableValue}"
                                                             Visibility="{Binding HasParent, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{loc:T LabelHash}" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelHash}" Text="{Binding HashText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas" />

                                            <!-- Run.AutoApprove: Liste der Tools, die in diesem Run automatisch genehmigt werden -->
                                            <TextBlock Text="{loc:T LabelAutoApprove}" Style="{StaticResource FieldLabel}" Foreground="DarkRed"
                                                       Visibility="{Binding IsAutoApprove, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelAutoApprove}" Text="{Binding AutoApproveText, Mode=OneWay}" Style="{StaticResource CopyableValue}"
                                                     Visibility="{Binding IsAutoApprove, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Text="{loc:T LabelSideEffects}" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelSideEffects}" Text="{Binding SideEffectsText, Mode=OneWay}" Style="{StaticResource CopyableValue}" />

                                            <TextBlock Text="{loc:T LabelArguments}" Style="{StaticResource FieldLabel}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelArguments}" Text="{Binding ArgumentsText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas" />

                                            <!-- Toolchain.*: Toolchain, Aktion und typisierte Parameter in Klartext -->
                                            <TextBlock Text="{loc:T LabelCommand}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelCommand}" Text="{Binding CommandText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}" />

                                            <!-- Web.Fetch: genau eine URL mit Grenzen (erste Freigabe) -->
                                            <TextBlock Text="{loc:T LabelWebFetch}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebFetch}" Text="{Binding WebFetchText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebDataWarnings}" Style="{StaticResource FieldLabel}" Foreground="DarkRed"
                                                       Visibility="{Binding HasWebDataWarnings, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebDataWarnings}" Text="{Binding WebDataWarningsText, Mode=OneWay}" Style="{StaticResource CopyableValue}"
                                                     Visibility="{Binding HasWebDataWarnings, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebData}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebData}" Text="{Binding WebDataText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebRequest}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebRequest}" Text="{Binding WebRequestText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding IsWebFetch, Converter={StaticResource BoolToVis}}" />

                                            <!-- Web.Content: exakt dieser bereinigte Text an genau diesen Agenten (zweite Freigabe) -->
                                            <TextBlock Text="{loc:T LabelWebSource}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebSource}" Text="{Binding WebSourceText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebResponse}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebResponse}" Text="{Binding WebResponseText, Mode=OneWay}" Style="{StaticResource CopyableValue}" FontFamily="Consolas"
                                                     Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebWarnings}" Style="{StaticResource FieldLabel}" Foreground="DarkRed"
                                                       Visibility="{Binding HasWebWarnings, Converter={StaticResource BoolToVis}}" />
                                            <TextBox AutomationProperties.Name="{loc:T LabelWebWarnings}" Text="{Binding WebWarningsText, Mode=OneWay}" Style="{StaticResource CopyableValue}"
                                                     Visibility="{Binding HasWebWarnings, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:T LabelWebText}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding WebText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="{loc:T LabelWebText}"
                                                     Visibility="{Binding IsWebContent, Converter={StaticResource BoolToVis}}" />

                                            <!-- Patch.Apply / Workspace.ExportPatch: vollständiger Diff je Datei, lesbar -->
                                            <TextBlock Text="{loc:T LabelPatch}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding HasPatch, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding PatchText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                     TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="420"
                                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="{loc:T LabelPatch}"
                                                     Visibility="{Binding HasPatch, Converter={StaticResource BoolToVis}}" />

                                            <DockPanel Margin="0,10,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:T LabelTargets}" Style="{StaticResource SectionHeader}" Margin="0" />
                                            </DockPanel>

                                            <!-- Sammelfreigabe: Filter und Sammelauswahl -->
                                            <DockPanel Margin="0,0,0,4" Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="{loc:T DeselectAllVisible}"
                                                        Command="{Binding DeselectAllVisibleCommand}" Padding="8,2" Margin="6,0,0,0" />
                                                <Button DockPanel.Dock="Right" Content="{loc:T SelectAllVisible}"
                                                        Command="{Binding SelectAllVisibleCommand}" Padding="8,2" Margin="6,0,0,0" />
                                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{loc:T Filter}"
                                                         ToolTip="{loc:T Filter}" />
                                            </DockPanel>

                                            <ListView ItemsSource="{Binding VisibleTargets}" MaxHeight="320"
                                                      VirtualizingPanel.IsVirtualizing="True">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1">
                                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsEnabled="{Binding DataContext.IsBatch, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                      AutomationProperties.Name="{Binding Path}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HashText}" Foreground="#6B7280"
                                                                       FontFamily="Consolas" Margin="8,0,0,0" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LinesText}" Foreground="#6B7280" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <TextBlock Text="{loc:T UntrustedHint}" Foreground="#6B7280" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
