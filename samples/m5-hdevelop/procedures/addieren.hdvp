<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.0.0">
<procedure name="addieren">
<interface>
<ic>
<par name="A" base_type="ctrl" dimension="0"/>
<par name="B" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Summe" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Summe von A und B</c>
<l>Summe := A + B</l>
<l>return ()</l>
</body>
<docu id="addieren">
<parameters>
<parameter id="A"/>
<parameter id="B"/>
<parameter id="Summe"/>
</parameters>
</docu>
</procedure>
</hdevelop>
