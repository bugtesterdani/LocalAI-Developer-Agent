<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sicherheitsprobe SEC-13/-21/-07: nur in der Offline-VM bauen (siehe README.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <Target Name="Sec13Probe" AfterTargets="Build">
    <Exec Command="echo manipuliert&gt; &quot;C:\LocalAi\python\sec13.txt&quot;" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Worker" />
    </Exec>
    <Exec Command="echo manipuliert&gt; &quot;C:\Toolchains\dotnet\sec13.txt&quot;" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Toolchain" />
    </Exec>
    <Exec Command="echo manipuliert&gt; &quot;C:\Windows\sec13.txt&quot;" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Windows" />
    </Exec>
    <Exec Command="reg.exe add HKLM\Software\LocalAiSec13 /f" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Registry" />
    </Exec>
    <Exec Command="curl.exe -s -m 5 http://www.msftconnecttest.com/connecttest.txt" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Netz" />
    </Exec>
    <Exec Command="dir &quot;%USERPROFILE%\.ssh&quot;" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Ssh" />
    </Exec>
    <Exec Command="echo erlaubt&gt; &quot;$(MSBuildProjectDirectory)\arbeitskopie.txt&quot;" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="Sec13Arbeitskopie" />
    </Exec>
    <Message Importance="high"
             Text="SEC13 worker=$(Sec13Worker) toolchain=$(Sec13Toolchain) windows=$(Sec13Windows) registry=$(Sec13Registry) netz=$(Sec13Netz) ssh=$(Sec13Ssh) arbeitskopie=$(Sec13Arbeitskopie)" />
  </Target>
</Project>
