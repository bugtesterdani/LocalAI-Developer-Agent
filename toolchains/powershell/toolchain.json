{
  "schemaVersion": 1,
  "name": "powershell",
  "version": "7.6.7",
  "displayName": "PowerShell 7.6.7 mit Pester und PSScriptAnalyzer",
  "guestPath": "C:\\Toolchains\\powershell",
  "license": {
    "proprietary": false,
    "note": "PowerShell: MIT; Pester: Apache-2.0; PSScriptAnalyzer: MIT"
  },
  "binaries": [
    { "name": "pwsh", "path": "pwsh.exe" }
  ],
  "install": {
    "kind": "Archive",
    "file": "PowerShell-7.6.7-win-x64.zip",
    "expectedMinutes": 2,
    "check": { "binary": "pwsh", "arguments": ["-NoProfile", "-NonInteractive", "-Command", "$PSVersionTable.PSVersion.ToString()"], "expectOutput": "7.6" }
  },
  "deploy": [
    { "source": "runner", "target": "runner" },
    { "source": "modules", "target": "Modules" }
  ],
  "selfTest": {
    "directory": "selftest",
    "steps": [
      { "binary": "pwsh", "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{guest}\\runner\\Invoke-LocalAiPester.ps1", "-Path", "{selftest}", "-Results", "{selftest}\\results"] },
      { "binary": "pwsh", "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{selftest}\\hallo.ps1"] }
    ],
    "expectOutput": "Hallo aus der Sandbox (PowerShell)"
  },
  "environment": {
    "POWERSHELL_TELEMETRY_OPTOUT": "1",
    "POWERSHELL_UPDATECHECK": "Off",
    "LOCALAI_PACKAGES": "{packages}"
  },
  "packageSource": { "kind": "PSModules", "path": "packages" },
  "actions": {
    "test": {
      "binary": "pwsh",
      "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{guest}\\runner\\Invoke-LocalAiPester.ps1", "-Path", "{path}", "-Results", "{results}"],
      "parameters": { "path": { "type": "Path" } },
      "timeoutSeconds": 600
    },
    "lint": {
      "binary": "pwsh",
      "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{guest}\\runner\\Invoke-LocalAiAnalyzer.ps1", "-Path", "{path}"],
      "parameters": { "path": { "type": "Path" } },
      "timeoutSeconds": 600
    },
    "run": {
      "binary": "pwsh",
      "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{script}"],
      "parameters": { "script": { "type": "Path" } },
      "timeoutSeconds": 120
    }
  },
  "testResultFormat": "JUnit"
}
