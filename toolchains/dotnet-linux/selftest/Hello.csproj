<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hallo-Welt für den Selbsttest beim VM-Aufbau. Zielframework = das des installierten SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Offline: keine Paketquellen außer der lokalen (siehe NuGet.Config). -->
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
  </PropertyGroup>
</Project>
