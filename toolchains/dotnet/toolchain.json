{
  "schemaVersion": 1,
  "name": "dotnet",
  "version": "9.0.306",
  "displayName": ".NET SDK 9.0.306",
  "guestPath": "C:\\Toolchains\\dotnet",
  "license": {
    "proprietary": false,
    "note": "MIT (.NET SDK)"
  },
  "binaries": [
    { "name": "dotnet", "path": "dotnet.exe" }
  ],
  "install": {
    "kind": "Archive",
    "file": "dotnet-sdk-9.0.306-win-x64.zip",
    "expectedMinutes": 5,
    "check": { "binary": "dotnet", "arguments": ["--version"], "expectOutput": "9.0.306" }
  },
  "selfTest": {
    "directory": "selftest",
    "steps": [
      { "binary": "dotnet", "arguments": ["build", "{selftest}\\Hello.csproj", "-c", "Release", "--nologo"] },
      { "binary": "dotnet", "arguments": ["run", "--project", "{selftest}\\Hello.csproj", "-c", "Release", "--no-build"] }
    ],
    "expectOutput": "Hallo aus der Sandbox (.NET)"
  },
  "environment": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "DOTNET_GENERATE_ASPNET_CERTIFICATE": "false",
    "DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE": "1",
    "NUGET_PACKAGES": "{work}\\nuget"
  },
  "packageSource": { "kind": "NuGet", "path": "packages" },
  "actions": {
    "restore": {
      "binary": "dotnet",
      "arguments": ["restore", "{project}", "-p:RestoreSources={packages}"],
      "parameters": { "project": { "type": "Path" } },
      "timeoutSeconds": 300
    },
    "build": {
      "binary": "dotnet",
      "arguments": ["build", "{project}", "-c", "{configuration}", "--nologo", "-p:RestoreSources={packages}"],
      "parameters": {
        "project": { "type": "Path" },
        "configuration": { "type": "Choice", "values": ["Debug", "Release"] }
      },
      "timeoutSeconds": 600
    },
    "test": {
      "binary": "dotnet",
      "arguments": ["test", "{project}", "-c", "{configuration}", "--nologo", "-p:RestoreSources={packages}", "--logger", "trx", "--results-directory", "{results}"],
      "parameters": {
        "project": { "type": "Path" },
        "configuration": { "type": "Choice", "values": ["Debug", "Release"] }
      },
      "timeoutSeconds": 600
    },
    "run": {
      "binary": "dotnet",
      "arguments": ["run", "--project", "{project}", "-c", "{configuration}", "-p:RestoreSources={packages}"],
      "parameters": {
        "project": { "type": "Path" },
        "configuration": { "type": "Choice", "values": ["Debug", "Release"] }
      },
      "timeoutSeconds": 120
    },
    "format": {
      "binary": "dotnet",
      "arguments": ["format", "{project}", "--verify-no-changes"],
      "parameters": { "project": { "type": "Path" } },
      "timeoutSeconds": 300
    }
  },
  "testResultFormat": "Trx"
}
