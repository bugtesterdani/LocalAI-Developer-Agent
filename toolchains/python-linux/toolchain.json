{
  "schemaVersion": 1,
  "name": "python-linux",
  "version": "3.13.5",
  "displayName": "Python 3.13.5 mit pytest (Linux-VM)",
  "guestPath": "/opt/toolchains/python-linux",
  "guest": "Linux",
  "license": {
    "proprietary": false,
    "note": "PSF License (python-build-standalone); pytest: MIT"
  },
  "binaries": [
    { "name": "python", "path": "python/bin/python3" }
  ],
  "install": {
    "kind": "Archive",
    "file": "cpython-3.13.5+20250612-x86_64-unknown-linux-gnu-install_only.tar.gz",
    "expectedMinutes": 2,
    "check": { "binary": "python", "arguments": ["--version"], "expectOutput": "3.13.5" }
  },
  "postInstall": [
    { "binary": "python", "arguments": ["-m", "pip", "install", "--no-index", "--find-links", "{source}/wheels", "pytest"] }
  ],
  "selfTest": {
    "directory": "selftest",
    "steps": [
      { "binary": "python", "arguments": ["-m", "pytest", "-q", "-p", "no:cacheprovider", "{selftest}"] },
      { "binary": "python", "arguments": ["{selftest}/hello.py"] }
    ],
    "expectOutput": "Hallo aus der Sandbox (Python)"
  },
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUTF8": "1",
    "PIP_NO_INDEX": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "packageSource": { "kind": "Pip", "path": "wheels" },
  "actions": {
    "run": {
      "binary": "python",
      "arguments": ["{script}"],
      "parameters": { "script": { "type": "Path" } },
      "timeoutSeconds": 120
    },
    "test": {
      "binary": "python",
      "arguments": ["-m", "pytest", "-q", "-p", "no:cacheprovider", "{path}", "--junitxml={results}/pytest.xml"],
      "parameters": { "path": { "type": "Path" } },
      "timeoutSeconds": 600
    }
  },
  "testResultFormat": "JUnit"
}
