{
  "project": "config/demo-project.json",
  "toolchains": {
    "directory": "D:\\Agent\\Toolchains"
  },
  "sandbox": {
    "mode": "dev-local-unsafe",
    "defaultGuestOs": "Windows",
    "devWorker": {
      "command": "uv",
      "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.worker"],
      "workingDirectory": "."
    },
    "hyperv": {
      "imagePath": "D:\\Agent\\WindowsImage\\windows11.iso",
      "imageName": "Windows 11 Pro",
      "vmName": "LocalAi-Sandbox",
      "vmDirectory": null,
      "memoryMB": 8192,
      "processors": 4,
      "osDiskGB": 128,
      "transferDiskMB": 64,
      "buildTimeoutMinutes": 90,
      "productKey": null,
      "keepVmOnExit": false,
      "reuseVm": false,
      "idleMinutes": 30,
      "stopAction": "ShutDown",
      "hostMount": true,
      "inbound": "CopyVMFile",
      "imageLanguage": "de-DE"
    },
    "hypervLinux": {
      "imagePath": "D:\\Agent\\Linux\\debian-13-generic-amd64.raw",
      "prerequisites": "D:\\Agent\\Linux\\linux-gast",
      "vmName": "LocalAi-Linux",
      "vmDirectory": null,
      "memoryMB": 4096,
      "processors": 4,
      "osDiskGB": 64,
      "transferDiskMB": 64,
      "buildTimeoutMinutes": 30,
      "keepVmOnExit": false,
      "reuseVm": false,
      "idleMinutes": 30,
      "stopAction": "ShutDown",
      "hostMount": true,
      "inbound": "CopyVMFile"
    }
  },
  "orchestrator": {
    "command": "uv",
    "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.orchestrator"],
    "workingDirectory": ".",
    "heartbeatTimeoutSeconds": 30
  },
  "web": {
    "enabled": true,
    "command": {
      "command": "uv",
      "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.web"],
      "workingDirectory": "."
    },
    "maxBytes": 2097152,
    "timeoutSeconds": 15,
    "maxChars": 20000,
    "lowIntegrity": true,
    "allowedHosts": [],
    "caFile": null,
    "proxy": {
      "url": null,
      "username": null,
      "passwordFile": null,
      "dnsViaProxy": false,
      "connectByAddress": false
    }
  },
  "fakeAgent": {
    "command": "uv",
    "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.fake_agent"],
    "workingDirectory": "."
  }
}
