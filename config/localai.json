{
  "project": "config/demo-project.json",
  "toolchains": {
    "directory": "D:\\Agent\\Toolchains"
  },
  "sandbox": {
    "mode": "dev-local-unsafe",
    "devWorker": {
      "command": "uv",
      "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.worker"],
      "workingDirectory": "."
    },
    "hyperv": {
      "imagePath": "D:\\Agent\\WindowsImage\\windows11.iso",
      "imageName": "Windows 11 Pro",
      "vmName": "LocalAi-Sandbox",
      "vmDirectory": null,
      "memoryMB": 8192,
      "processors": 4,
      "osDiskGB": 128,
      "transferDiskMB": 64,
      "buildTimeoutMinutes": 90,
      "productKey": null,
      "keepVmOnExit": false
    }
  },
  "orchestrator": {
    "command": "uv",
    "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.orchestrator"],
    "workingDirectory": ".",
    "heartbeatTimeoutSeconds": 30
  },
  "fakeAgent": {
    "command": "uv",
    "arguments": ["run", "--no-sync", "--project", "src/python", "python", "-m", "localai.fake_agent"],
    "workingDirectory": "."
  }
}
